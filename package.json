{
  "name": "tb-health",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/prepare-data.mjs && astro dev",
    "prepare-data": "node scripts/prepare-data.mjs",
    "build": "node scripts/prepare-data.mjs && astro build && node scripts/check-links.mjs",
    "build:synthetic": "node scripts/prepare-data.mjs --synthetic && astro build && node scripts/check-links.mjs",
    "check": "astro check",
    "check-links": "node scripts/check-links.mjs",
    "launch-check": "node scripts/launch-check.mjs",
    "serve": "node scripts/serve-dist.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/preact": "6.1.1",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "astro": "7.4.5",
    "leaflet": "1.9.4",
    "preact": "11.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
