---
// The place shell (PLAN §4.4): the service worker serves it at the address of a place page
// that isn't saved yet, and the island renders that place from the saved facility list.
import PlaceShell from '../islands/PlaceShell.tsx';
import BaseLayout from '../layouts/BaseLayout.astro';
import { care } from '../content/care.ts';
import { chrome } from '../content/chrome.ts';
import { home } from '../content/home.ts';
import { meta } from '../content/meta.ts';
import { place } from '../content/place.ts';
import { pick, type Str } from '../content/types.ts';
import type { Lang } from '../lib/i18n.ts';
import '../styles/place.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = {
  ...pick(care, lang),
  ...pick(place, lang),
  nav_home: chrome.nav_home[lang],
  loading: home.loading[lang],
  failed: home.failed[lang],
  retry: home.retry[lang],
  notFoundTitle: meta.notFoundTitle[lang],
};
const title: Str = { en: 'TB PH', fil: 'TB PH', origin: 'ui', src: ['derived', 'derived'], note: 'The brand until the shell has read the place; then its name, as place pages are titled.' };
---
<BaseLayout lang={lang} title={title} current="home" standIn>
  <main id="main" tabindex="-1">
    <div class="frame frame--back">
      <PlaceShell client:load lang={lang} t={t} />
    </div>
  </main>
</BaseLayout>
