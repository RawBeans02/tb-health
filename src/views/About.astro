---
// About (README:244–245, About.dc.html). Static. "Use TB PH like an app" hides in the
// installed app (html[data-standalone="true"], set before paint). Helpful numbers are
// 44px tel: links; the owner's privacy row (Q5) shows once supplied.
import { TBPH_CHECK } from 'astro:env/server';
import BaseLayout from '../layouts/BaseLayout.astro';
import { about } from '../content/about.ts';
import { meta } from '../content/meta.ts';
import { fill, pick } from '../content/types.ts';
import { formatDate, LAST_UPDATED } from '../lib/dates.ts';
import { href, type Lang } from '../lib/i18n.ts';
import '../styles/about.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = pick(about, lang);
const title = { en: `${about.h1.en} — TB PH`, fil: `${about.h1.fil} — TB PH`, origin: 'ui', src: ['derived', 'derived'] } as const;
const privacy = [TBPH_CHECK ? t.privacy1 : t.privacy1NoCheck, t.privacy2, t.privacy3, t.privacyServices].filter(Boolean);
const numbers = [
  { who: t.n911_who, note: t.n911_note, number: '911', tel: 'tel:911' },
  { who: t.n1555_who, note: t.n1555_note, number: '1555', tel: 'tel:1555' },
  { who: t.lcp_who, note: t.fromList, number: t.lcp_number, tel: 'tel:+63289246101' },
  { who: t.pts_who, note: t.fromList, number: t.pts_number, tel: 'tel:+63283565857' },
  { who: t.local_who, note: t.local_note },
];
---
<BaseLayout lang={lang} title={title} description={meta.aboutDescription} current="about">
  <main id="main" tabindex="-1">
    <div class="frame">
      <div class="about">
        <section id="mission" class="about-section" data-anchor>
          <h1 class="h1">{t.h1}</h1>
          <p class="lede">{t.lede}</p>
        </section>

        {/* The prototype's "Our partners" and "Medical review" sections are left out for launch (A1, 8 Nov 2026). */}

        <section id="disclaimer" class="about-section" data-anchor aria-labelledby="disclaimer-h">
          <h2 id="disclaimer-h" class="h2">{t.disclaimer}</h2>
          <div class="about-card"><p>{TBPH_CHECK ? t.disclaimerText : t.disclaimerTextNoCheck}</p></div>
        </section>

        <section id="privacy" class="about-section" data-anchor aria-labelledby="privacy-h">
          <h2 id="privacy-h" class="h2">{t.privacy}</h2>
          <ul class="group about-inset" role="list">
            {privacy.map((row) => <li><p>{row}</p></li>)}
          </ul>
        </section>

        <section id="updates" class="about-section" data-anchor aria-labelledby="updates-h">
          <h2 id="updates-h" class="h2">{t.updates}</h2>
          <div class="about-card"><p>{fill(t.updatesText, { date: formatDate(LAST_UPDATED, lang) })}</p></div>
        </section>

        <section id="app" class="about-section install-entry" data-anchor aria-labelledby="app-h">
          <h2 id="app-h" class="h2">{t.appH}</h2>
          <ul class="group about-rows" role="list">
            <li class="about-loose">{TBPH_CHECK ? t.appText : t.appTextNoCheck}</li>
            <li class="link-row-item">
              <a class="link-row" href={href('install', lang)}><span>{t.appLink}</span><span class="link-row-chevron" aria-hidden="true">›</span></a>
            </li>
          </ul>
        </section>

        <section id="accessibility" class="about-section" data-anchor aria-labelledby="accessibility-h">
          <h2 id="accessibility-h" class="h2">{t.a11y}</h2>
          <div class="about-card"><p>{t.a11yText}</p></div>
        </section>

        <section id="numbers" class="about-section" data-anchor aria-labelledby="numbers-h">
          <h2 id="numbers-h" class="h2">{t.numbers}</h2>
          <ul class="group about-inset" role="list">
            {
              numbers.map((n) => (
                <li>
                  <div class="number-row">
                    <div class="number-who">
                      <p class="number-name">{n.who}</p>
                      <p class="number-note">{n.note}</p>
                    </div>
                    {n.tel && (
                      <a class="number-tel" href={n.tel} aria-label={fill(t.call, { who: n.who, number: n.number })}>
                        {n.number}
                      </a>
                    )}
                  </div>
                </li>
              ))
            }
          </ul>
        </section>

        {/* The prototype's Contact section is left out: the site launches without a contact email (A3, 9 Nov 2026). */}
      </div>
    </div>
  </main>
</BaseLayout>
