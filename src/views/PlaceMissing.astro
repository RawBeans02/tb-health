---
// /place/{unknown} and /fil/place/{unknown}: the host serves this nearest 404.html with a
// 404 status (README:220). The offline place shell shows the same missing state.
import BaseLayout from '../layouts/BaseLayout.astro';
import { PlaceMissing } from '../islands/PlaceShell.tsx';
import { care } from '../content/care.ts';
import { meta } from '../content/meta.ts';
import { place } from '../content/place.ts';
import type { Lang } from '../lib/i18n.ts';
import '../styles/place.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---
<BaseLayout lang={lang} title={meta.notFoundTitle} current="home" notFound>
  <main id="main" tabindex="-1">
    <div class="frame frame--back">
      <PlaceMissing lang={lang} t={{ missing: place.missing[lang], seeMore: care.seeMore[lang] }} />
    </div>
  </main>
</BaseLayout>
