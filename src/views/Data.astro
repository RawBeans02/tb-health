---
// The data (PLAN §5 step 9). The dot story comes first: its text beats are static and its
// stage is an island. The charts are one island, prerendered at a default width and re-laid
// out at the real width (D13); everything else is static. Statistics and claims are built in
// (D12).
import { TBPH_CHECK } from 'astro:env/server';
import DataCharts from '../islands/DataCharts.tsx';
import DotStory from '../islands/DotStory.tsx';
import BaseLayout from '../layouts/BaseLayout.astro';
import claims from '../../data/claims.json' with { type: 'json' };
import stats from '../../data/tb-ph-data.json' with { type: 'json' };
import regionCounts from '../generated/region-counts.json' with { type: 'json' };
import { charts } from '../content/charts.ts';
import { dataPage } from '../content/datapage.ts';
import { dotStage, dotStory } from '../content/dotstory.ts';
import { meta } from '../content/meta.ts';
import { pick } from '../content/types.ts';
import { readFacilities } from '../lib/build-data.ts';
import { storyData } from '../lib/dotstory.ts';
import { href, type Lang } from '../lib/i18n.ts';
import { italics } from '../lib/learn.ts';
import { pageTitle } from '../lib/title.ts';
import '../styles/data.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = pick(dataPage, lang);
const ts = pick(dotStory, lang);
const tStage = pick(dotStage, lang);
const story = storyData(stats);
const [sourcesBefore, sourcesAfter] = ts.b7_sources.split('{link}');
const tx = pick(charts, lang);
const facilities = readFacilities();
const regions = {
  n: facilities.meta.count,
  sample: facilities.meta.sample,
  names: Object.fromEntries(regionCounts.map((r) => [r.code, r.region])),
  counts: Object.fromEntries(regionCounts.map((r) => [r.code, r.total])),
};
const ids = Array.from({ length: 20 }, (_, i) => `d${i + 1}`);
const topics = ['burden', 'detection', 'who', 'drivers', 'testing', 'treatment', 'prevention', 'cost', 'funding', 'targets', 'regional'] as const;
const sources = claims.sources as Record<string, { title: string; url: string }>;
const title = { en: pageTitle(dataPage.h2.en), fil: pageTitle(dataPage.h2.fil), origin: 'ui', src: ['derived', 'derived'] } as const;
---
<BaseLayout lang={lang} title={title} description={meta.dataDescription} current="data">
  <main id="main" tabindex="-1">
    <section id="story" class="story">
      <DotStory client:visible lang={lang} d={story} tx={tStage} />
      <div class="story-text">
        <div id="beat-1" class="story-step" data-anchor>
          <div class="story-beat story-beat--stack" data-beat="0">
            <h1>{ts.b1_h1}</h1>
            <p class="story-lead">{ts.b1_line}</p>
            <p class="story-small">{ts.b1_small}</p>
          </div>
        </div>
        <div id="beat-2" class="story-step" data-anchor>
          <div class="story-beat" data-beat="1">
            <p class="story-big">{ts.b2}</p>
          </div>
        </div>
        <div id="beat-3" class="story-step" data-anchor>
          <div class="story-beat story-beat--stack" data-beat="2">
            <h2>{ts.b3_h2}</h2>
            <p class="story-body">{ts.b3_line}</p>
          </div>
        </div>
        <div id="beat-4" class="story-step" data-anchor>
          <div class="story-beat" data-beat="3">
            <h2>{ts.b4_h2}</h2>
          </div>
        </div>
        <div id="beat-5" class="story-step" data-anchor>
          <div class="story-beat" data-beat="4">
            <h2>{ts.b5_h2}</h2>
            <div class="visually-hidden">
              <p>{ts.seaCaption}</p>
              <ul>
                {story.sea.map((c) => <li>{`${c.iso === 'PHL' ? tStage.ph : c.name}: ${c.rate.toLocaleString('en-US')}`}</li>)}
              </ul>
            </div>
          </div>
        </div>
        <div id="beat-6" class="story-step" data-anchor>
          <div class="story-beat" data-beat="5">
            <h2>{ts.b6_h2}</h2>
            <div class="visually-hidden">
              <p>{ts.change}</p>
              <ul>
                <li>{`${tStage.ph}: +${story.ph.toFixed(1)}%`}</li>
                <li>{`${tStage.world}: −${Math.abs(story.world).toFixed(1)}%`}</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="turn" class="turn" data-anchor>
      <div class="turn-wrap">
        <div class="turn-inner">
          <h2>{ts.b7_h2}</h2>
          <p class="story-lead">{ts.b7_line}</p>
          <div class="turn-actions">
            {TBPH_CHECK && <a class="btn btn--primary" href={href('check', lang)}>{ts.b7_check}</a>}
            <a class="btn btn--soft" href={href('home', lang)}>{ts.b7_find}</a>
          </div>
          <p class="turn-sources">{sourcesBefore}<a href="#charts">{ts.b7_link}</a>{sourcesAfter}</p>
        </div>
      </div>
    </section>

    <div id="charts" class="data">
      <div id="top" class="data-top" data-anchor tabindex="-1">
        <div class="data-intro">
          <h2>{t.h2}</h2>
          <p>{t.intro}</p>
        </div>
        <nav class="data-index" aria-labelledby="idx-h">
          <h2 id="idx-h">{t.onPage}</h2>
          <ul class="group" role="list">
            {ids.map((id) => <li><a class="link-row" href={`#${id}`}><span>{tx[`${id}_title` as keyof typeof tx]}</span><span class="link-row-chevron" aria-hidden="true">›</span></a></li>)}
            <li><a class="link-row" href="#numbers"><span>{t.inNumbers}</span><span class="link-row-chevron" aria-hidden="true">›</span></a></li>
          </ul>
        </nav>
        <details id="methods" class="group data-methods" data-anchor>
          <summary><span>{t.methods}</span><span class="toc-chevron" aria-hidden="true">›</span></summary>
          <ul>
            {[t.method1, t.method2, t.method3, t.method4, t.method5, t.method6].map((m) => <li>{italics(m).map((r) => (r.italic ? <i>{r.text}</i> : r.text))}</li>)}
          </ul>
        </details>
      </div>

      <DataCharts client:visible={{ rootMargin: '800px' }} lang={lang} tx={tx} top={t.top} regions={regions} />

      <section id="numbers" class="numbers" data-anchor aria-labelledby="numbers-h">
        <h2 id="numbers-h">{t.inNumbers}</h2>
        <p class="numbers-lead">{t.inNumbersLead}</p>
        <div class="segmented numbers-topics" role="group" aria-label={t.topic}>
          {['all', ...topics].map((k) => <button type="button" data-topic={k} aria-pressed={k === 'all' ? 'true' : 'false'}>{t[`topic_${k}` as keyof typeof t]}</button>)}
        </div>
        <div class="field numbers-select">
          <label class="field-label" for="topic">{t.topic}</label>
          <span class="select">
            <select id="topic">
              {['all', ...topics].map((k) => <option value={k}>{t[`topic_${k}` as keyof typeof t]}</option>)}
            </select>
          </span>
        </div>
        {
          topics.map((k) => (
            <div class="numbers-group" data-group={k}>
              <h3>{t[`topic_${k}` as keyof typeof t]}</h3>
              <ul class="group inset-group" role="list">
                {claims.claims
                  .filter((c) => c.topic === k)
                  .map((c) => (
                    <li id={`claim-${c.id}`} tabindex="-1">
                      <div class="numbers-row">
                        <p>{c[lang]}</p>
                        <p class="numbers-meta">
                          <span>{c.kind}</span>, {c.year}.{' '}
                          {c.sources.map((sid, i) => (
                            <>
                              <a href={sources[sid].url}>{sources[sid].title}</a>
                              {i < c.sources.length - 1 ? '; ' : ''}
                            </>
                          ))}
                        </p>
                      </div>
                    </li>
                  ))}
              </ul>
            </div>
          ))
        }
        <a class="panel-link" href="#top" data-to-top>{t.top}</a>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import '../scripts/data.ts';
</script>
