---
// 404 (README:247, 404.dc.html): one line and two ways back. Served by the host for any
// unknown address, in the language of the nearest 404.html (/fil/… gets Filipino).
// Without Check (TBPH_CHECK=false, Q9) the Check button goes; the lead line names no page.
import { TBPH_CHECK } from 'astro:env/server';
import BaseLayout from '../layouts/BaseLayout.astro';
import { chrome } from '../content/chrome.ts';
import { meta } from '../content/meta.ts';
import { notFound } from '../content/notfound.ts';
import { pick } from '../content/types.ts';
import { href, type Lang } from '../lib/i18n.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = pick(notFound, lang);
const nav = pick(chrome, lang);
---
<BaseLayout lang={lang} title={meta.notFoundTitle} notFound>
  <main id="main" tabindex="-1">
    <div class="frame">
      <div class="notice">
        <div class="notice-head">
          <h1 class="h1">{t.h1}</h1>
          <p class="lede">{t.lead}</p>
        </div>
        <div class="notice-actions">
          <a class="btn btn--primary" href={href('home', lang)}>{nav.nav_home}</a>
          {TBPH_CHECK && <a class="btn btn--soft btn--lg" href={href('check', lang)}>{nav.nav_check}</a>}
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

