---
// Page frame shared by every route: head tags, the pre-paint script, header, footer and
// the language links (PLAN §4.2). Pages pass their title and description as dictionary
// strings so in-place pages can carry both languages.
import { createHash } from 'node:crypto';
import { Font } from 'astro:assets';
import { TBPH_CHECK } from 'astro:env/server';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import InPlaceLanguage from '../components/InPlaceLanguage.astro';
import type { Str } from '../content/types.ts';
import { pagePath, toLang, type Lang } from '../lib/i18n.ts';
import { CANVAS } from '../lib/manifest.ts';
import prepaint from '../scripts/prepaint.js?raw';
import type { Features, NavKey } from '../lib/nav.ts';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/chrome.css';
import '../styles/ui.css';

interface Props {
  lang: Lang;
  title: Str;
  description?: Str;
  /** Nav item marked current. Places and Place mark 'home' (README:133). */
  current?: NavKey | '';
  /** 404 pages: noindex, no canonical or alternates, language links to the homes. */
  notFound?: boolean;
  /** The offline page and the place shell, which the service worker serves at other pages'
      addresses: noindex, no canonical or alternates (scripts/lang.ts points the language
      links at the real address's twin). */
  standIn?: boolean;
  /** Check, Places, Home: the language can switch without a navigation (PLAN §4.2). */
  inPlace?: boolean;
  /** English path to name as canonical when it isn't this page's (an alias of a place, Q6). */
  canonicalPath?: string;
  /** The share preview's text when it isn't the description (Home, as the prototype has it). */
  shareText?: Str;
}

const { lang, title, description, current = '', notFound = false, standIn = false, inPlace = false, canonicalPath, shareText } = Astro.props;
const indexed = !notFound && !standIn;
const features: Features = { check: TBPH_CHECK };
const site = Astro.site!; // SITE_URL, or the placeholder until Q7 (launch-check flags it)
const path = canonicalPath ?? toLang(pagePath(Astro.url.pathname), 'en');
const canonical = new URL(toLang(path, lang), site).href;
const togglePath = notFound ? '/' : path;
// Astro hashes the scripts it bundles, not is:inline ones.
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(prepaint).digest('base64')}`);
const descriptionText = description?.[lang] || undefined;
const shareDescription = shareText?.[lang] || descriptionText;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title[lang]}</title>
    {descriptionText && <meta name="description" content={descriptionText} />}
    {!indexed && <meta name="robots" content="noindex" />}
    {indexed && <link rel="canonical" href={canonical} />}
    {indexed && <link rel="alternate" hreflang="en" href={new URL(path, site).href} />}
    {indexed && <link rel="alternate" hreflang="fil" href={new URL(toLang(path, 'fil'), site).href} />}
    {indexed && <link rel="alternate" hreflang="x-default" href={new URL(path, site).href} />}
    {/* Share previews (Open Graph), from the page's own title and text. The in-place language
        switch doesn't update them: a link shared after it is the other page's address, and
        previews read that page's HTML. */}
    {
      indexed && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="TB PH" />
          <meta property="og:url" content={canonical} />
          <meta property="og:title" content={title[lang]} />
          {shareDescription && <meta property="og:description" content={shareDescription} />}
          <meta property="og:image" content={new URL('/icons/og-image.png', site).href} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    {/* The canvas token. A meta tag can't read CSS; dark mode (V2) adds a prefers-color-scheme: dark twin. */}
    <meta name="theme-color" content={CANVAS} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="TB PH" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <Font cssVariable="--font-atkinson" preload={[{ weight: 400, style: 'normal' }, { weight: 700, style: 'normal' }]} />
    <Font cssVariable="--font-newsreader" />
  </head>
  <body>
    <script is:inline set:html={prepaint} />
    <div class="page">
      <SiteHeader lang={lang} current={current} togglePath={togglePath} features={features} />
      <slot />
      <SiteFooter lang={lang} current={current} togglePath={togglePath} features={features} />
    </div>
    {inPlace && <InPlaceLanguage title={title} description={description} />}
    <script>
      import '../scripts/lang.ts';
      import '../scripts/pwa.ts';
    </script>
  </body>
</html>
